#templates
[template-shared-gnu]
compiler     = gnu
cflags       = $CSHARED_GNU $OPTIMIZE
lflags       = $LSHARED $OPTIMIZE
mod_dir      = ./mod/
obj_dir      = ./obj/
src          = ./src/
exclude_dirs = $EXDIRS src/mpi/
colors       = True
quiet        = False
log          = True
jobs         = 10

