[project]
name       = VTKFortran
version    = VERSION
summary    = Pure Fortran VTK (XML) API
repository = https://github.com/szaghi/VTKFortran
website    = https://szaghi.github.io/VTKFortran
email      = stefano.zaghi@gmail.it
authors    = Stefano Zaghi

[scaffold]
apt_packages = zlib1g-dev libhdf5-dev
skip         = docs/guide/contributing.md

[dependencies]
deps_dir   = src/third_party
BeFoR64    = https://github.com/szaghi/BeFoR64
FACE       = https://github.com/szaghi/FACE
FoXy       = https://github.com/Fortran-FOSS-Programmers/FoXy
PENF       = https://github.com/szaghi/PENF
StringiFor = https://github.com/szaghi/StringiFor

[modes]
modes = shared-gnu static-gnu static-gnu-zlib tests-gnu
        shared-gnu-debug static-gnu-debug tests-gnu-debug
        tests-gnu-debug-zlib
        static-gnu-hdf5 tests-gnu-debug-hdf5
        static-gnu-hdf5-mpi tests-gnu-debug-hdf5-mpi
        shared-intel static-intel tests-intel
        shared-intel-debug static-intel-debug tests-intel-debug

# The HDF5 modes (VTKHDF) link the HDF5 C library, nothing else of HDF5 (no Fortran modules): $HDF5_LIB is its
# directory, $HDF5_EXT the libraries to link. The default varset is Ubuntu's libhdf5-dev (serial), as the CI; add a
# varset for another HDF5, e.g. a parallel one ($HDF5_EXT then lists the MPI libraries too), and select it with
#   fobis build --mode tests-gnu-debug-hdf5 --varset <name>
# The MPI modes (VTKHDF files written by MPI ranks: VTKFORTRAN_USE_MPI) need a parallel HDF5, its headers too
# ($HDF5_INC, for the C source src/mpi/vtk_fortran_mpi.c, excluded by the other modes: they need no C compiler), and
# the MPI compilers (mpifort, mpicc), e.g. Ubuntu's libhdf5-openmpi-dev:
#   fobis build --mode tests-gnu-debug-hdf5-mpi --varset ubuntu-openmpi
[varsets]
default = ubuntu

[varset:ubuntu]
$HDF5_LIB = /usr/lib/x86_64-linux-gnu/hdf5/serial
$HDF5_INC = /usr/include/hdf5/serial
$HDF5_EXT = hdf5 z

[varset:ubuntu-openmpi]
$HDF5_LIB = /usr/lib/x86_64-linux-gnu/hdf5/openmpi
$HDF5_INC = /usr/include/hdf5/openmpi
$HDF5_EXT = hdf5 z

[common-variables]
$CSHARED_GNU = -cpp -c -fPIC -frealloc-lhs
$CSHARED_INT = -cpp -c -fpic -assume realloc_lhs -recursive
$LSHARED     = -shared
$CSTATIC_GNU = -cpp -c -frealloc-lhs
$CSTATIC_INT = -cpp -c -assume realloc_lhs -recursive
$DEBUG_GNU   = -O0 -no-pie -g3 -Warray-bounds -Wcharacter-truncation -Wline-truncation -Wimplicit-interface -Wimplicit-procedure -Wunderflow -Wuninitialized -fcheck=all -ffree-line-length-132 -fimplicit-none -fbacktrace -fdump-core -finit-real=nan
$DEBUG_INT   = -O0 -check arg_temp_created -check format -check assume -check format -check output_conversion -check pointers -check stack -debug all -warn all -extend-source 132 -traceback
$OPTIMIZE    = -O2
$EXDIRS      = src/pre-lib/
               BeFoR64/src/tests/
               FACE/src/tests/
               FoXy/src/tests/
               PENF/src/tests/
               StringiFor/src/tests/
               BeFoR64/docs/
               FACE/docs/
               FoXy/docs/
               PENF/docs/
               StringiFor/docs/
               BeFoR64/scripts/
               FACE/scripts/
               FoXy/scripts/
               PENF/scripts/
               StringiFor/scripts/
               FoXy/benchmarks/

# main modes
[shared-gnu]
template  = template-shared-gnu
target    = src/lib/vtk_fortran.f90
build_dir = ./shared/
output    = libvtkfortran.so
mklib     = shared

[static-gnu]
template  = template-static-gnu
target    = src/lib/vtk_fortran.f90
build_dir = ./static/
output    = libvtkfortran.a
mklib     = static

[static-gnu-zlib]
